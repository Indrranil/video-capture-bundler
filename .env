# ============================================================
# BASIC CONFIG
# ============================================================

# Directory inside container where all outputs (recordings, zips, etc.) will be stored.
# For testing, use /tmp so files are not persisted permanently.
OUTPUT_DIR=/tmp/video-test-output

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# ============================================================
# CAMERA CONFIGURATION
# ============================================================

# Logical names of cameras (comma-separated if multiple)
# Example: cam1,cam2,cam3
CAMERAS=cam1

# IP addresses corresponding to each camera (same order as CAMERAS)
# Example: 10.0.0.12,10.0.0.13
CAMERA_IPS=127.0.0.1

# RTSP URLs for live camera streams (same order as CAMERAS)
# Leave empty for dry-run/testing mode (no real camera connection)
RTSP_URLS=


# ============================================================
# METADATA (USED IN MANIFEST / REPORTING)
# ============================================================

# Name of factory/site (used in metadata and file naming)
FACTORY_NAME=DUMMY_FACTORY

# Target object/class for detection pipelines (used in downstream logic)
TARGET_CLASS=DUMMY_OBJ


# ============================================================
# VIDEO RECORDING SETTINGS
# ============================================================

# Duration of each recorded chunk (in seconds)
VIDEO_DURATION=5

# Frames per second for recording
VIDEO_FPS=5

# Output video resolution
VIDEO_WIDTH=640
VIDEO_HEIGHT=480


# ============================================================
# FEATURE TOGGLES (CORE CONTROL FLAGS)
# ============================================================

# Enable actual video recording from RTSP stream
# false = NO recording, container runs in idle/dry mode
ENABLE_RECORDING=false

# Enable bundling of recorded video chunks into ZIP files
ENABLE_BUNDLING=false

# Enable manifest file generation (metadata JSON)
ENABLE_MANIFEST=false

# Enable upload of bundles to Google Cloud Storage
ENABLE_GCS_UPLOAD=false

# Enable pushing metadata/events to external API
ENABLE_API_PUSH=false


# ============================================================
# KAFKA CONFIGURATION (EVENT-DRIVEN MODE)
# ============================================================

# Kafka broker hostname (use "kafka" if running inside Docker network)
KAFKA_HOST=localhost

# Kafka broker port
KAFKA_PORT=9092

# Consumer group ID for Kafka listener
KAFKA_GROUP_ID=video-capture-bundler

# Mapping of camera → Kafka topic (format: cam1:topic1,cam2:topic2)
# Leave empty to DISABLE Kafka listener
CAMERA_TOPICS=


# ============================================================
# VERDICT CONFIGURATION (FOR EVENT PROCESSING)
# ============================================================

# Numeric value representing anomaly event
VERDICT_ANOMALY=1

# Numeric value representing normal event
VERDICT_NORMAL=0


# ============================================================
# TIMEZONE & SAMPLING CONFIG
# ============================================================

# Timezone used for timestamps and scheduling
TIMEZONE=Asia/Kolkata

# Hour of day when logical "day" starts (for grouping data)
DAY_START_HOUR=6

# Number of normal samples to collect per day (used in sampling logic)
NORMAL_SAMPLES_PER_DAY=12

# Duration (in hours) of each sampling bin
NORMAL_BIN_HOURS=2

# Random seed for reproducibility in sampling logic
RANDOM_SEED=42


# ============================================================
# GOOGLE CLOUD STORAGE (GCS) CONFIG
# ============================================================

# Target GCS bucket name (required only if ENABLE_GCS_UPLOAD=true)
GCS_BUCKET=

# Physical location of factory/site (used in storage path)
FACTORY_LOCATION=

# Factory name used in upload path (can differ from FACTORY_NAME)
UPLOAD_FACTORY_NAME=


# ============================================================
# API INTEGRATION CONFIG
# ============================================================

# Base URL of API server
API_URL=

# API login email
API_EMAIL=

# API login password (keep secure, do not commit real creds)
API_PASSWORD=


# ============================================================
# PIPELINE IDENTIFICATION
# ============================================================

# Application ID (used by backend systems)
APP_ID=0

# Logical pipeline name (used for tracking/analytics)
PIPELINE_NAME=
