# =========================
# BASIC CONFIG
# =========================
OUTPUT_DIR=/tmp/video-test-output
LOG_LEVEL=INFO

# =========================
# CAMERAS (DUMMY / DISABLED)
# =========================
CAMERAS=cam1
CAMERA_IPS=127.0.0.1
RTSP_URLS=

# =========================
# META (DUMMY)
# =========================
FACTORY_NAME=DUMMY_FACTORY
TARGET_CLASS=DUMMY_OBJ

# =========================
# RECORDING CONFIG
# =========================
VIDEO_DURATION=5
VIDEO_FPS=5
VIDEO_WIDTH=640
VIDEO_HEIGHT=480

# =========================
# MODULE TOGGLES (ALL OFF)
# =========================
ENABLE_RECORDING=false
ENABLE_BUNDLING=false
ENABLE_MANIFEST=false
ENABLE_GCS_UPLOAD=false
ENABLE_API_PUSH=false

# =========================
# KAFKA (DISABLED)
# =========================
KAFKA_HOST=localhost
KAFKA_PORT=9092
KAFKA_GROUP_ID=video-capture-bundler
CAMERA_TOPICS=

# =========================
# VERDICT CONFIG
# =========================
VERDICT_ANOMALY=1
VERDICT_NORMAL=0

# =========================
# TIMEZONE / SAMPLING
# =========================
TIMEZONE=Asia/Kolkata
DAY_START_HOUR=6
NORMAL_SAMPLES_PER_DAY=12
NORMAL_BIN_HOURS=2
RANDOM_SEED=42

# =========================
# GCS (DISABLED)
# =========================
GCS_BUCKET=
FACTORY_LOCATION=
UPLOAD_FACTORY_NAME=

# =========================
# API (DISABLED)
# =========================
API_URL=
API_EMAIL=
API_PASSWORD=

# =========================
# PIPELINE IDENTITY (DUMMY)
# =========================
APP_ID=0
PIPELINE_NAME=
