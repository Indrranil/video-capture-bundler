OUTPUT_DIR=./output
LOG_LEVEL=INFO

# Cameras
CAMERAS=cam1
CAMERA_IPS=10.0.0.12
RTSP_URLS=rtsp://978324467:Rishabh1!@10.0.0.12:554/Streaming/Channels/101

# Dummy meta for now (used in manifest)
FACTORY_NAME=DUMMY_FACTORY
TARGET_CLASS=DUMMY_OBJ

# Recording
VIDEO_DURATION=20
VIDEO_FPS=25
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080

# Module toggles
ENABLE_RECORDING=true
ENABLE_BUNDLING=true
ENABLE_MANIFEST=true

# Bundling
ZIP_MODE=chunk
DAILY_MAX_SIZE_MB=2048

# Kafka
KAFKA_HOST=localhost
KAFKA_PORT=9092
KAFKA_GROUP_ID=video-capture-bundler-test
CAMERA_TOPICS=cam1:polarisai

# Verdict mapping
VERDICT_ANOMALY=1
VERDICT_NORMAL=0

# IST day-window + sampling
TIMEZONE=Asia/Kolkata
DAY_START_HOUR=6
NORMAL_SAMPLES_PER_DAY=12
NORMAL_BIN_HOURS=2
RANDOM_SEED=42

# Upload
ENABLE_GCS_UPLOAD=true
GCS_BUCKET=polarisai-recorded-dataset
FACTORY_LOCATION=Nashik
UPLOAD_FACTORY_NAME=cam1

# API push
ENABLE_API_PUSH=false
API_URL=
API_EMAIL=
API_PASSWORD=

# Pipeline identity
APP_ID=0
PIPELINE_NAME=
