
OUTPUT_DIR=./output
LOG_LEVEL=INFO

# Cameras (comma-separated, same length)
CAMERAS=cam1
CAMERA_IPS=10.0.0.12
RTSP_URLS=rtsp://978324467:Rishabh1!@10.0.0.12:554/Streaming/Channels/101

# Dummy meta for now (used in manifest)
FACTORY_NAME=DUMMY_FACTORY
TARGET_CLASS=DUMMY_OBJ

# Recording (AVI style)
VIDEO_DURATION=120
VIDEO_FPS=25
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080

# Module toggles (keep everything switchable)
ENABLE_RECORDING=true
ENABLE_BUNDLING=true
ENABLE_MANIFEST=true

# Bundling mode
ZIP_MODE=chunk
DAILY_MAX_SIZE_MB=2048

# Kafka
KAFKA_HOST=localhost
KAFKA_PORT=29092
KAFKA_GROUP_ID=video-capture-bundler
CAMERA_TOPICS=cam1:model-det-out

# Verdict mapping
VERDICT_ANOMALY=1
VERDICT_NORMAL=0

# IST day-window (6am->6am) + sampling
TIMEZONE=Asia/Kolkata
DAY_START_HOUR=6
NORMAL_SAMPLES_PER_DAY=12
NORMAL_BIN_HOURS=2
RANDOM_SEED=42

# Upload path rule (team)
ENABLE_GCS_UPLOAD=true
GCS_BUCKET=your-bucket-name
FACTORY_LOCATION=your_factory_location
UPLOAD_FACTORY_NAME=your_factory_name   # optional; falls back to FACTORY_NAME if empty

# API push (aligned with new config)
ENABLE_API_PUSH=false
API_URL=
API_EMAIL=
API_PASSWORD=

# Pipeline identity (used for pipeline-session creation / metadata publish)
APP_ID=0
PIPELINE_NAME=
