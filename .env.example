
OUTPUT_DIR=./output
LOG_LEVEL=INFO

# Cameras — LEGACY, one-time migration seed only. The recorder loop and webui now read
# cameras from output/state/cameras.json (src/camera_store.py); manage cameras via the
# Cameras page / POST/PUT/DELETE /api/cameras instead of editing these. These three are only
# consulted the first time cameras.json doesn't exist yet, to avoid losing an existing
# deployment's cameras — safe to leave as-is or remove once cameras.json is populated.
CAMERAS=cam1
CAMERA_IPS=10.0.0.12
RTSP_URLS=rtsp://user:pass@10.0.0.12:554/Streaming/Channels/101

# Dummy meta for now (until real meta comes)
FACTORY_NAME=DUMMY_FACTORY
TARGET_CLASS=DUMMY_OBJ

# Recording (AVI style)
VIDEO_DURATION=120
VIDEO_FPS=25
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080

# Module toggles (keep everything switchable)
ENABLE_RECORDING=true
ENABLE_BUNDLING=true
ENABLE_MANIFEST=true

# Bundling mode
ZIP_MODE=chunk          # chunk | daily
DAILY_MAX_SIZE_MB=2048  # safety limit

# Upload — ENABLE_GCS_UPLOAD gates upload to whichever STORAGE_PROVIDER is selected below
ENABLE_GCS_UPLOAD=false
STORAGE_PROVIDER=gcp    # gcp | azure | aws | acecloud | krutrim
FACTORY_LOCATION=
UPLOAD_FACTORY_NAME=

# GCP
GCS_BUCKET=
GCS_PROJECT_ID=polaris-ai-452710

# Azure
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=

# Generic S3-compatible (shared by aws / acecloud / krutrim — only S3_ENDPOINT_URL changes;
# blank endpoint = real AWS). S3_ENDPOINT_URL is scheme+host ONLY, e.g.
# "https://hyd2.kos.olakrutrimsvc.com" — do NOT include the bucket in it (bucket goes in
# S3_BUCKET below); a bucket-suffixed endpoint doubles the bucket into every object path.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
